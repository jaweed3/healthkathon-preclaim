meta {
  name: Analyze synthetic claim
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/claims/analyze
  body: json
  auth: inherit
}

body:json {
  {
    "claim": {
      "id": "CLM-DEMO-001",
      "patient": "Pasien Demo-001",
      "service": "Rawat inap • Bedah",
      "date": "18 Okt 2026",
      "amount": "Rp 18.450.000",
      "status": "Perlu ditinjau",
      "score": 0,
      "readiness": 0,
      "diagnosis": "K35.8 — Apendisitis akut",
      "procedure": "99.04 — Transfusi eritrosit",
      "length": "4 hari",
      "flags": []
    },
    "claims": []
  }
}

tests {
  test("returns an explained analysis", function() {
    expect(res.status).to.equal(200);
    expect(res.body.claimId).to.equal("CLM-DEMO-001");
    expect(res.body.findings).to.be.an("array");
  });
}
