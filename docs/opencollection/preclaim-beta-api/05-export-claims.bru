meta {
  name: Export synthetic claims
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/claims/export
  body: json
  auth: inherit
}

body:json {
  {
    "claims": []
  }
}

tests {
  test("returns a JSON export download", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-disposition"]).to.contain("preclaim-claims.json");
  });
}
