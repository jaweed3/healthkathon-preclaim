meta {
  name: List synthetic claims
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/claims
  body: none
  auth: inherit
}

tests {
  test("returns synthetic beta claims", function() {
    expect(res.status).to.equal(200);
    expect(res.body.source).to.equal("synthetic-beta-data");
    expect(res.body.claims.length).to.be.greaterThan(0);
  });
}
